{
  "name": "feimo-desktop-assistant",
  "productName": "斐墨",
  "version": "1.2.4",
  "description": "常驻 Windows 桌面的轻量即时助手：悬浮宠物 + 工作栏（问答 / 文本处理 / OCR / Agent 状态 / Token 用量 / 日程提醒）",
  "main": "main.js",
  "author": "Opal Desk",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist:win": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "reicon": "^1.2.4"
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "image-size": "^2.0.4",
    "katex": "^0.18.1",
    "marked": "^18.0.14",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "com.feimo.desktop",
    "productName": "斐墨",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload/**/*",
      "renderer/**/*",
      "lib/**/*",
      "assets/**/*",
      "assets/pets/eous/**",
      "package.json",
      "LICENSE",
      "!assets/pets/kenney/**",
      "!lib/pets.local.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Feimo-${version}-Setup-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Feimo-${version}-Portable-${arch}.${ext}"
    }
  }
}
